# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# --- Single-service free-tier deployment (Hugging Face Spaces + Neon/Supabase) ---
# DATABASE_URL: leave empty to use a local SQLite file (zero-config demo).
# postgres:// is accepted and converted; sslmode=require is added for remote hosts.
# PORT: port of the combined Flask API + Dash dashboard (Spaces uses 7860).
PORT=7860
# API_BASE_URL: where the dashboard reaches the API (default: same server).
# API_BASE_URL=http://127.0.0.1:7860/api
# REDIS_URL is optional; an in-memory cache is used when unset or unreachable.

# Database Configuration
# Paste your Neon/Supabase connection string here (keep it secret):
DATABASE_URL=
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Redis Configuration
# REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Market Data Provider APIs
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here
FINNHUB_API_KEY=your-finnhub-key-here
POLYGON_API_KEY=your-polygon-key-here
RAPID_API_KEY=your-rapid-api-key-here

# Stock and Cryptocurrency Symbols
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA
CRYPTO_SYMBOLS=BTC-USD,ETH-USD,BNB-USD,SOL-USD,XRP-USD,ADA-USD,DOGE-USD

# Forecast Configuration
FORECAST_DAYS=30
LOOKBACK_DAYS=365

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8050,http://localhost:5000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Dash Dashboard Configuration
DASH_PORT=8050
DASH_HOST=0.0.0.0
DASH_DEBUG=True

# API Rate Limiting
API_RATE_LIMIT=100/hour
API_RATE_LIMIT_ENABLED=True

# Cache Configuration
CACHE_TYPE=RedisCache
CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TIMEOUT=300

# Email Configuration (Optional - for alerts/notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Webhook Configuration (Optional - for notifications)
SLACK_WEBHOOK_URL=store-in-secrets-manager
DISCORD_WEBHOOK_URL=store-in-secrets-manager

# AWS Configuration (Optional - for deployment)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name

# Security Configuration
ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Development/Testing Configuration
TESTING=False
PRESERVE_CONTEXT_ON_EXCEPTION=False

# Performance Configuration
WORKERS=4
WORKER_CLASS=sync
WORKER_TIMEOUT=120
MAX_CONNECTIONS=10
