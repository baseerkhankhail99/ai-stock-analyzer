# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=postgresql://stock_user:stock_password@localhost:5432/stock_analyzer
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys (Get from respective platforms)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_key_here
POLYGON_API_KEY=your_polygon_key_here
RAPID_API_KEY=your_rapid_api_key_here

# Stock Configuration
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,JPM,V,JNJ
CRYPTO_SYMBOLS=BTC-USD,ETH-USD,BNB-USD,XRP-USD

# Forecasting
FORECAST_DAYS=30
LOOKBACK_DAYS=60

# Technical Analysis
SMA_PERIODS=20,50,200
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26

# Server
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8050

# Caching
CACHE_TIMEOUT=300
CACHE_REDIS_URL=redis://localhost:6379/1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Batch Processing
BATCH_SIZE=100
MAX_WORKERS=4

# Feature Flags
ENABLE_FORECASTING=True
ENABLE_TECHNICAL_ANALYSIS=True
ENABLE_ANALYTICS=True
ENABLE_CRYPTO=True

# Email (for alerts)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_USE_TLS=True

# Dashboard
DASH_PORT=8050
DASH_DEBUG=True

# Data Update Frequency (in hours)
DATA_UPDATE_INTERVAL=1
FORECAST_UPDATE_INTERVAL=24
INDICATOR_UPDATE_INTERVAL=1
